{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feed-me",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feed-me-staging",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
