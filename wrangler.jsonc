{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "feed-me",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feed-me-staging",
      "database_id": "57ab9230-d10c-4fd3-bdf6-648244dc0f79"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "57ab9230-d10c-4fd3-bdf6-648244dc0f79"
      }
    ]
  }
}
